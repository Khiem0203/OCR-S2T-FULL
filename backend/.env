# Xác thực API
# Header X-API-Key hoặc Authorization: Bearer; nhiều key cách nhau bằng dấu phẩy
API_KEYS="your_api_key_1,your_api_key_2"
# Chỉ dùng khi dev: tắt xác thực
AUTH_DISABLED="false"
ENABLE_DOCS="false"
CORS_ORIGINS=""
# Host callback_url được phép; trống = mọi host
WEBHOOK_ALLOWED_HOSTS=""

# RabbitMQ / Celery
CELERY_BROKER_URL="amqp://your_rabbitmq_user:your_rabbitmq_password@localhost:5672//"
CELERY_RESULT_BACKEND="db+postgresql://your_celery_db_user:your_celery_db_password@localhost:5432/celery_results"

# PostgreSQL (kết quả fullpage)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="your_ocr_db"
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="your_db_password"

# S3 / MinIO
S3_ENDPOINT='http://localhost:9000/'
S3_ACCESS_KEY='your_s3_access_key'
S3_SECRET_KEY='your_s3_secret_key'
S3_REGION='us-east-1'
S3_SSL=False

# Chandra OCR (vLLM)
CHANDRA_MODEL="/path/to/models--datalab-to--chandra-ocr-2/snapshots/<snapshot_id>"
# Trống = không cần key
CHANDRA_API_KEY=""
CHANDRA_URL="http://localhost:8101/v1/chat/completions"
CHANDRA_MAX_TOKENS="4096"
CHANDRA_TIMEOUT="300"
OCR_CONCURRENCY="4"
# Card GPU; cổng phải khớp CHANDRA_URL
CHANDRA_CUDA_DEVICE="0"
CHANDRA_PORT="8101"
CHANDRA_MAX_MODEL_LEN="6000"
CHANDRA_GPU_MEMORY_UTILIZATION="0.95"
CHANDRA_MAX_NUM_BATCHED_TOKENS="9216"
CHANDRA_MAX_NUM_SEQS="20"
CHANDRA_PREFIX_CACHING="true"
CHANDRA_VLLM_EXTRA_ARGS=""

# ProtonX sửa chính tả
SPELLFIX_API_URL="http://localhost:8006/spellfix/correct"
SPELLFIX_MODEL="/path/to/models--protonx-models--protonx-legal-tc/snapshots/<snapshot_id>"
SPELLFIX_CUDA_DEVICE="1"
SPELLFIX_DTYPE="float32"
SPELLFIX_NUM_BEAMS="4"
SPELL_MODE="both"
SPELL_REVIEW="suspects"

# File đầu vào
# Ưu tiên lấy text từ docx/doc/odt/rtf/txt/md có sẵn, không dùng được mới OCR
TEXT_FIRST="true"
# Chỉ định 1 file thì lấy thêm file cùng tên khác đuôi trong cùng thư mục
INPUT_SIBLINGS="true"
# Text không có ngắt trang thì chia trang ảo khoảng chừng này ký tự
TEXT_PAGE_CHARS="3000"
# Sửa chính tả cả text lấy từ file văn bản (mặc định chỉ sửa text OCR)
SPELL_TEXT_FILES="false"
# Lấy text PDF trực tiếp; 1 trang lỗi Unicode là OCR cả file
PDF_TEXT_FIRST="true"
# Tỉ lệ từ có trong từ điển tối thiểu (cả file) để dùng text PDF
PDF_TEXT_MIN_KNOWN="0.9"

# Speech-to-text: PhoWhisper (vLLM)
# Model (tên Hugging Face hoặc đường dẫn snapshot)
PHOWHISPER_MODEL="vinai/PhoWhisper-large"
# Tên model khi gọi API (--served-model-name)
PHOWHISPER_MODEL_NAME="phowhisper-large"
# Trống = không cần key
PHOWHISPER_API_KEY=""
PHOWHISPER_URL="http://localhost:8120/v1/audio/transcriptions"
PHOWHISPER_TIMEOUT="300"
# Card GPU; cổng phải khớp PHOWHISPER_URL
PHOWHISPER_CUDA_DEVICE="0"
PHOWHISPER_PORT="8120"
# Tỉ lệ VRAM được dùng (0-1); model fp16 khoảng 3 GB
PHOWHISPER_GPU_MEMORY_UTILIZATION="0.8"
PHOWHISPER_MAX_NUM_SEQS="64"
# Cờ vllm thêm
PHOWHISPER_VLLM_EXTRA_ARGS=""
# Số đoạn gửi cùng lúc
ASR_CONCURRENCY="16"
SPEECH_LANGUAGE="vi"
# Độ dài đoạn (giây); Whisper chỉ nghe tối đa 30 giây
SPEECH_MIN_CHUNK="15"
SPEECH_MAX_CHUNK="28"
# Đoạn có biên độ không vượt mức này coi là im lặng, bỏ qua
SPEECH_SILENCE_LEVEL="300"
# Giới hạn tổng thời lượng (phút) và dung lượng mỗi file (MB)
SPEECH_MAX_MINUTES="360"
SPEECH_MAX_UPLOAD_MB="500"
# all: ProtonX xem mọi đoạn | suspects: chỉ đoạn có từ lạ
SPEECH_SPELL_REVIEW="all"

# Tải file lên từ máy (frontend)
# Thư mục lưu file tải lên; trống = TEMP_DIR/uploads. API và worker phải dùng chung
UPLOAD_DIR=""
# Số file tối đa mỗi lần tải lên
MAX_UPLOAD_FILES="200"

# Flower
# user:password (bắt buộc, Flower hiện cả khóa S3)
FLOWER_BASIC_AUTH="your_flower_user:your_flower_password"
FLOWER_URL="http://localhost:5555"
