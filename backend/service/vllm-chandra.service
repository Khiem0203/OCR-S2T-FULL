[Unit]
Description=vLLM Service for datalab-to/chandra-ocr-2
After=network.target

[Service]
User=cntt
Group=cntt
WorkingDirectory=/home/cntt/ocr-fullpage/backend
Environment="PATH=/home/cntt/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HUB_OFFLINE=1"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/home/cntt/.venv/bin/vllm serve datalab-to/chandra-ocr-2 \
    --host 0.0.0.0 \
    --port 8101 \
    --trust-remote-code \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.6 \
    --max-num-batched-tokens 9216 \
    --max-num-seqs 8 \
    --enable-prefix-caching \
    --disable-log-stats
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
