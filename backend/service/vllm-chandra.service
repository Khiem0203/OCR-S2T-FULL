[Unit]
Description=vLLM Service for datalab-to/chandra-ocr-2
After=network.target

[Service]
User=cntt
Group=cntt
WorkingDirectory=/home/cntt/ocr-fullpage
Environment="PATH=/home/cntt/.venv/bin:/usr/local/bin:/usr/bin:/bin"
#Environment="HF_HOME=/mnt/data/huggingface"
Environment="HF_HUB_OFFLINE=1"
# Giá trị mặc định; .env ghi đè
Environment="CHANDRA_CUDA_DEVICE=0" "CHANDRA_PORT=8101" "CHANDRA_MAX_MODEL_LEN=6000" "CHANDRA_GPU_MEMORY_UTILIZATION=0.95"
Environment="CHANDRA_MAX_NUM_BATCHED_TOKENS=9216" "CHANDRA_MAX_NUM_SEQS=20" "CHANDRA_PREFIX_CACHING=true"
Environment="CHANDRA_API_KEY=" "CHANDRA_VLLM_EXTRA_ARGS="
EnvironmentFile=/home/cntt/ocr-fullpage/.env
ExecStart=/bin/bash -c 'args=(--host 127.0.0.1 --port "$${CHANDRA_PORT}" --trust-remote-code --disable-log-stats \
    --max-model-len "$${CHANDRA_MAX_MODEL_LEN}" --gpu-memory-utilization "$${CHANDRA_GPU_MEMORY_UTILIZATION}" \
    --max-num-batched-tokens "$${CHANDRA_MAX_NUM_BATCHED_TOKENS}" --max-num-seqs "$${CHANDRA_MAX_NUM_SEQS}"); \
    [ "$${CHANDRA_PREFIX_CACHING}" = "true" ] && args+=(--enable-prefix-caching); \
    [ -n "$${CHANDRA_API_KEY}" ] && args+=(--api-key "$${CHANDRA_API_KEY}"); \
    CUDA_VISIBLE_DEVICES="$${CHANDRA_CUDA_DEVICE}" exec /home/cntt/.venv/bin/vllm serve "$${CHANDRA_MODEL}" "$${args[@]}" $${CHANDRA_VLLM_EXTRA_ARGS}'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
