[Unit]
Description=vLLM Service for datalab-to/chandra-ocr-2
After=network.target

[Service]
User=your_user
Group=your_group
WorkingDirectory=/path/to/ocr-toanvan/backend
Environment="PATH=/path/to/python-env/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HUB_OFFLINE=1"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/path/to/python-env/bin/vllm serve /path/to/models--datalab-to--chandra-ocr-2/snapshots/<snapshot_id> \
    --host 0.0.0.0 \
    --port 8101 \
    --trust-remote-code \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.6 \
    --max-num-batched-tokens 9216 \
    --max-num-seqs 8 \
    --enable-prefix-caching \
    --disable-log-stats
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
