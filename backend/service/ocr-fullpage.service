[Unit]
Description=OCR full page (API + Celery workers)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=your_user
Group=your_group
WorkingDirectory=/path/to/ocr-toanvan/backend
ExecStart=/bin/bash /path/to/ocr-toanvan/backend/start-service.sh
ExecStop=/bin/bash /path/to/ocr-toanvan/backend/stop-service.sh
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
