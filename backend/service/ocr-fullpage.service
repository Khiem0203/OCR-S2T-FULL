[Unit]
Description=OCR full page (API + Celery workers)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
# User sở hữu thư mục dự án
User=ocr
Group=ocr
WorkingDirectory=/opt/ocr-fullpage
# Khóa nằm trong .env (chmod 600); VENV_BIN trỏ tới venv
Environment=VENV_BIN=/opt/ocr-fullpage/.venv/bin
ExecStart=/bin/bash /opt/ocr-fullpage/start-service.sh
ExecStop=/bin/bash /opt/ocr-fullpage/stop-service.sh
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
