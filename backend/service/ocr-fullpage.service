[Unit]
Description=OCR full page (API + Celery workers)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ocr
Group=ocr
WorkingDirectory=/opt/ocr-fullpage/backend
Environment=VENV_BIN=/opt/ocr-fullpage/backend/.venv/bin
ExecStart=/bin/bash /opt/ocr-fullpage/backend/start-service.sh
ExecStop=/bin/bash /opt/ocr-fullpage/backend/stop-service.sh
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
