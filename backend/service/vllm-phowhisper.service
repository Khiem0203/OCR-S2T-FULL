[Unit]
Description=vLLM Service for vinai/PhoWhisper-large
After=network.target

[Service]
User=cntt
Group=cntt
WorkingDirectory=/home/cntt/ocr-fullpage/backend
Environment="PATH=/home/cntt/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HF_HUB_OFFLINE=1"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/home/cntt/.venv/bin/vllm serve vinai/PhoWhisper-large \
    --host 0.0.0.0 \
    --port 8120 \
    --served-model-name phowhisper-large \
    --dtype float16 \
    --max-model-len 448 \
    --gpu-memory-utilization 0.5 \
    --max-num-seqs 64 \
    --disable-log-stats
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
