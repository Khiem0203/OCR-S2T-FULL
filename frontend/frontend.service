[Unit]
Description=OCR & speech-to-text frontend
After=network.target

[Service]
User=your_user
Group=your_group
WorkingDirectory=/path/to/ocr-toanvan/frontend
Environment="BACKEND_URL=http://127.0.0.1:9090"
ExecStart=/path/to/python-env/bin/uvicorn server:app --host 0.0.0.0 --port 6767 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
