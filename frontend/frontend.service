[Unit]
Description=OCR & speech-to-text frontend
After=network.target

[Service]
User=ocr
Group=ocr
WorkingDirectory=/opt/ocr-fullpage/frontend
Environment="BACKEND_URL=http://127.0.0.1:9090"
ExecStart=/opt/ocr-fullpage/backend/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8080 --proxy-headers
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
